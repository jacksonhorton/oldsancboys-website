---
import "../styles/tailwind.css";
import { Image } from "astro:assets";

// images
import camp24Image from "../images/carousel/camp24.jpg";
import fofClinton1Image from "../images/carousel/fof-clinton1.jpg";
import fofClinton2Image from "../images/carousel/fof-clinton2.jpg";
import fofClinton3Image from "../images/carousel/fof-clinton3.jpg";
import fofClinton4Image from "../images/carousel/fof-clinton4.jpg";
import thriveCoverImage from "../images/Thrive.jpg";
import projectorImage from "../images/united-projector.webp";
import unitedPursuitWideImage from "../images/united-wide.webp";
import jacksonImage from "../images/united-jackson.webp";
import charlesImage from "../images/united-charles.webp";
import joshImage from "../images/united-josh.webp";
import unitedPursuitImage from "../images/united-pursuit.webp";
---

<div
    class="flex flex-col space-y-6 md:space-y-10 lg:space-y-14 w-screen md:w-3/4 lg:w-1/2 m-auto max-w-none lg:max-w-4xl"
>
    <div class="flex flex-row justify-center">
        <!-- class="max-h-svh w-auto max-w-sm md:max-w-2xl lg:max-w-4xl mx-auto" -->
        <Image
            class="shadow-xl w-9/12"
            src={unitedPursuitWideImage}
            width={unitedPursuitWideImage.width}
            height={unitedPursuitWideImage.height}
            alt=""
            loading="lazy"
        />
        <div class="w-1/6 h-auto hidden md:block"></div>
    </div>
    <div
        class="flex flex-row justify-center space-x-8 md:space-x-12 items-center"
    >
        <Image
            class="w-5/12 self-end mb-12 md:mb-24 rounded-lg shadow-xl"
            src={unitedPursuitImage}
            width={unitedPursuitImage.width}
            height={unitedPursuitImage.height}
            alt="Projector with United Pursuit on it."
            loading="lazy"
        />
        <Image
            class="w-2/5 h-2/5 md:w-1/3 md:h-3/12 self-end -mb-6 rounded-lg shadow-xl hidden md:block"
            src={projectorImage}
            width={projectorImage.width}
            height={projectorImage.height}
            alt="Projector with United Pursuit on it."
            loading="lazy"
        />
        <Image
            class="shadow-xl w-5/12 h-auto"
            src={joshImage}
            width={joshImage.width}
            height={joshImage.height}
            alt=""
            loading="lazy"
        />
    </div>
    <div class="flex flex-row justify-center items-start">
        <Image
            class="shadow-xl w-1/2 mt-12"
            src={charlesImage}
            width={charlesImage.width}
            height={charlesImage.height}
            alt=""
            loading="lazy"
        />
        <div class="w-1/12"></div>
        <Image
            class="shadow-xl w-4/12"
            src={jacksonImage}
            width={jacksonImage.width}
            height={jacksonImage.height}
            alt=""
            loading="lazy"
        />
    </div>
</div>
