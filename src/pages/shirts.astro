---
import PageLayout from "../layouts/PageLayout.astro";

const pageTitle = "Shirts";
const formUrl = "https://docs.google.com/forms/d/e/1FAIpQLSckCO5z2ONTEiCyKzwTw9boIaB0QZGx876yUdSNcaNTZWFXFA/viewform?embedded=true";
---

<PageLayout
	title={pageTitle}
	description="Order Old Sanc Boys shirts through the official shirt form."
	hideMobileTitle={true}
	bodyClass="shirts-page"
>
	<section class="shirts-form-shell w-full px-0 pb-0 md:px-6 md:pb-8">
		<div class="shirts-form-inner mx-auto w-full max-w-5xl">
			<iframe
				src={formUrl}
				title="Old Sanc Boys shirt order form"
				class="shirts-form-frame h-full w-full border-0 bg-transparent md:h-[calc(100vh-14rem)] md:min-h-[720px]"
				loading="lazy"
				marginheight="0"
				marginwidth="0"
				allowtransparency="true"
			>
				Loading...
			</iframe>
		</div>
	</section>
</PageLayout>

<style>
	@media (max-width: 767px) {
		:global(body.shirts-page) {
			height: 100dvh;
			min-height: 100dvh;
			overflow: hidden;
		}

		:global(body.shirts-page main),
		:global(body.shirts-page article) {
			display: flex;
			flex: 1 1 auto;
			flex-direction: column;
			min-height: 0;
			overflow: hidden;
		}

		:global(body.shirts-page footer) {
			display: none;
		}

		.shirts-form-shell,
		.shirts-form-inner {
			display: flex;
			flex: 1 1 auto;
			height: 100%;
			min-height: 0;
		}

		.shirts-form-inner {
			max-width: none;
		}

		.shirts-form-frame {
			display: block;
			flex: 1 1 auto;
			height: 100%;
			min-height: 0;
		}
	}
</style>
